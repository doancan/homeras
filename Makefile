# Single entry point for building, checking and running Homeras. CI calls the same targets.
# `make verify` needs no network once `make setup` has run.

PROJECT  := Homeras.xcodeproj
SCHEME   := Homeras
PKG      := Packages/AppModules
RESOLVED := $(PROJECT)/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
SIM_NAME ?= iPhone 17
DEST     ?= platform=iOS Simulator,name=$(SIM_NAME),OS=latest
BUNDLE_ID ?= app.homeras.Homeras
SWIFT_SOURCES := App AppTests $(PKG)/Sources $(PKG)/Tests $(PKG)/Package.swift

# Reads API_URL, PUBLISHABLE_KEY and MAILPIT_URL of the running local stack.
SUPABASE_ENV = supabase status -o env 2>/dev/null | grep -E '^(API_URL|PUBLISHABLE_KEY|MAILPIT_URL)='

.DEFAULT_GOAL := help
.PHONY: help setup generate verify format format-check test-packages test-app \
	db-start db-stop db-reset verify-db verify-integration verify-security local-config run

help: ## List targets
	@grep -hE '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-20s %s\n", $$1, $$2}'

setup: ## Check tools and resolve Swift packages (needs network)
	@command -v xcodegen >/dev/null || { echo "Missing xcodegen: brew install xcodegen"; exit 1; }
	@command -v supabase >/dev/null || echo "Note: supabase CLI not found (needed for db targets): brew install supabase/tap/supabase"
	swift package --package-path $(PKG) resolve

generate: ## Generate the Xcode project from project.yml and pin package versions
	xcodegen generate --quiet
	@mkdir -p $(dir $(RESOLVED))
	@cp $(PKG)/Package.resolved $(RESOLVED)

verify: generate format-check test-packages test-app ## All quality gates (format, strict build, tests)

format: ## Rewrite Swift sources in the project style
	swift format --in-place --recursive --parallel $(SWIFT_SOURCES)

format-check: ## Fail on Swift style violations
	swift format lint --strict --recursive --parallel $(SWIFT_SOURCES)

test-packages: ## Unit tests of all Swift modules (warnings are errors)
	swift test --package-path $(PKG) --skip SupabaseBackendIntegrationTests

test-app: ## Build the iOS app and run its tests on the simulator
	set -o pipefail; xcodebuild test -project $(PROJECT) -scheme $(SCHEME) -destination '$(DEST)' \
		-onlyUsePackageVersionsFromResolvedFile \
		| grep -E '(✔ Test run|✘|error:|\*\* TEST)'

db-start: ## Start the local Supabase stack (Docker)
	supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime,storage-api,postgres-meta

db-stop: ## Stop the local Supabase stack
	supabase stop

db-reset: ## Recreate the local database from migrations
	supabase db reset

verify-db: db-start db-reset ## Apply all migrations from scratch and run the RLS/tenant tests
	supabase test db

verify-integration: verify-db ## verify-db plus the Swift adapter end to end against the local stack
	eval "$$($(SUPABASE_ENV))" && \
	HOMERAS_SUPABASE_URL="$$API_URL" HOMERAS_SUPABASE_PUBLISHABLE_KEY="$$PUBLISHABLE_KEY" \
	HOMERAS_MAILPIT_URL="$$MAILPIT_URL" \
	swift test --package-path $(PKG) --filter SupabaseBackendIntegrationTests

verify-security: ## Scan the repository history for committed secrets
	@command -v gitleaks >/dev/null || { echo "Missing gitleaks: brew install gitleaks"; exit 1; }
	gitleaks git --no-banner

local-config: ## Write Config/Local.xcconfig for the running local stack
	@eval "$$($(SUPABASE_ENV))" && \
	printf '%s\n' \
		'// Generated by `make local-config` for the local Supabase stack. Git-ignored.' \
		"HOMERAS_SUPABASE_URL = $$(echo "$$API_URL" | sed 's|://|:/$$()/|')" \
		"HOMERAS_SUPABASE_PUBLISHABLE_KEY = $$PUBLISHABLE_KEY" > Config/Local.xcconfig
	@echo "Wrote Config/Local.xcconfig"

run: generate ## Build and launch the app on the newest SIM_NAME (default iPhone 17) simulator
	set -o pipefail; xcodebuild build -project $(PROJECT) -scheme $(SCHEME) -destination '$(DEST)' \
		-derivedDataPath build -onlyUsePackageVersionsFromResolvedFile -quiet
	@# Runtimes are listed oldest first, so the last match is the newest iOS.
	@udid="$$(xcrun simctl list devices available | grep -E '^ +$(SIM_NAME) \(' | tail -1 | grep -oE '[0-9A-F-]{36}')"; \
	xcrun simctl boot "$$udid" 2>/dev/null || true; \
	open -a Simulator; \
	xcrun simctl install "$$udid" build/Build/Products/Debug-iphonesimulator/Homeras.app && \
	xcrun simctl launch "$$udid" $(BUNDLE_ID)
