{
  "sourceLanguage": "tr",
  "strings": {
    "action.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar dene"
          }
        }
      }
    },
    "error.alreadyInHousehold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already belong to a household."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten bir eve üyesiniz."
          }
        }
      }
    },
    "error.forbidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to do this."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem için yetkiniz yok."
          }
        }
      }
    },
    "error.invalidOrExpiredCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is invalid or has expired."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod geçersiz ya da süresi dolmuş."
          }
        }
      }
    },
    "error.notAuthenticated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please sign in again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumunuzun süresi doldu. Lütfen yeniden giriş yapın."
          }
        }
      }
    },
    "error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Check your connection and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet bağlantısı yok. Bağlantınızı kontrol edip tekrar deneyin."
          }
        }
      }
    },
    "error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait a moment and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla deneme yapıldı. Biraz bekleyip tekrar deneyin."
          }
        }
      }
    },
    "error.rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This couldn't be saved. Check it and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgi kaydedilemedi. Kontrol edip tekrar deneyin."
          }
        }
      }
    },
    "error.unexpected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şeyler ters gitti. Lütfen tekrar deneyin."
          }
        }
      }
    },
    "validation.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This field can't be empty."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alan boş bırakılamaz."
          }
        }
      }
    },
    "validation.invalidFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid value."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli bir değer girin."
          }
        }
      }
    },
    "validation.tooLong %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at most %lld characters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla %lld karakter girebilirsiniz."
          }
        }
      }
    }
  },
  "version": "1.0"
}
